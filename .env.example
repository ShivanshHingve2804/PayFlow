# Local development (SQLite)
DATABASE_URL=sqlite:///./payflow.db

# Docker / Production (PostgreSQL)
# DATABASE_URL=postgresql://payflow:payflow@localhost:5432/payflow

TESTING=false

# Kafka / Redpanda Streaming
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=payflow.transactions
KAFKA_GROUP_ID=payflow-audit-consumer
OUTBOX_BATCH_SIZE=100
RECONCILIATION_LOOKBACK_DAYS=1
